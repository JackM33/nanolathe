#!/usr/bin/env python3
"""Package inspected community-map roots; never infer editions or dependencies.

Usage: tools/package-maps --root /path/to/roots --recipe recipe.json --out output
Recipe: {schema:1, release_base:HTTPS_URL, maps:[...], dependencies:[...]}; each
entry supplies id, name, version, summary, homepage and optional provenance.
Map entries also supply map and requires, and may carry the optional
presentation fields author, players, sizemap, year, kind and ai, which the
catalogue's map browser displays and filters on (docs/DESIGN_MODS_MUTATORS.md
§5.6). They never change package bytes or validation.
Each root is ROOT/ID. HPI archives must already have been inspected and
expanded (tools/map-expand); preserve their authored bytes. The engine's
maplibrary.Validator remains the acceptance gate before publishing.
"""
import argparse
import hashlib
import json
import pathlib
import re
import stat
import zipfile

# Optional map-record fields the browser labels, sorts and filters on. Each
# keeps its declared JSON type; a bool is never an int.
PRESENTATION_FIELDS = {
    "author": str,
    "players": int,
    "sizemap": str,
    "year": int,
    "kind": str,
    "ai": str,
}


def fail(message):
    raise SystemExit("package-maps: " + message)


def allowed(path):
    parts = pathlib.PurePosixPath(path).parts
    suffix = pathlib.PurePosixPath(path).suffix.lower()
    if len(parts) == 1:
        return suffix in {".txt", ".md", ".rtf", ".html"} or parts[0].lower() in {
            "readme", "license", "copying"
        }
    tree = parts[0].lower()
    return (
        (tree == "maps" and len(parts) == 2 and suffix in {".ota", ".tnt"})
        or (tree == "features" and suffix == ".tdf")
        or (tree == "anims" and suffix == ".gaf" and path.lower() != "anims/vismasks.gaf")
        or (tree == "objects3d" and suffix == ".3do")
        or (tree == "textures" and suffix in {".gaf", ".bmp", ".pcx"})
    )


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", required=True, type=pathlib.Path)
    parser.add_argument("--recipe", required=True, type=pathlib.Path)
    parser.add_argument("--out", required=True, type=pathlib.Path)
    args = parser.parse_args()
    recipe = json.loads(args.recipe.read_text())
    if recipe.get("schema") != 1:
        fail("unsupported recipe schema")
    release_base = recipe["release_base"]
    if not release_base.startswith("https://") or not release_base.endswith("/"):
        fail("release_base must be an HTTPS directory URL")
    args.out.mkdir(parents=True, exist_ok=True)
    manifest = {"schema": 1, "maps": [], "dependencies": []}
    inventory = []
    ids = set()
    dependency_ids = {e["id"] for e in recipe["dependencies"]}
    for kind in ("maps", "dependencies"):
        for entry in recipe[kind]:
            ident, version = entry["id"], entry["version"]
            # The engine's package identity rule (modlibrary): an id is lowercase
            # ASCII letters, digits and hyphens, and both parts are at most 64
            # bytes. The version stays a subset of the engine's version rule.
            if (not re.fullmatch(r"[a-z0-9-]{1,64}", ident)
                    or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", version)):
                fail("unsafe identity: " + ident)
            if ident in ids:
                fail("duplicate identity: " + ident)
            ids.add(ident)
            root = args.root / ident
            if not root.is_dir() or root.is_symlink():
                fail("missing or linked package root: " + str(root))
            files = {}
            for source in sorted(root.rglob("*")):
                if source.is_symlink():
                    fail("symlink: " + str(source))
                if not source.is_file():
                    continue
                relative = source.relative_to(root).as_posix()
                path = relative.lower()
                if path in files:
                    fail("case-insensitive duplicate: " + relative)
                if not allowed(relative):
                    fail("unexpected map-package file: " + relative)
                files[path] = source.read_bytes()
            if kind == "maps":
                logical = entry["map"].lower()
                if logical not in files or str(pathlib.PurePosixPath(logical).with_suffix(".tnt")) not in files:
                    fail("missing map pair: " + logical)
                if not set(entry.get("requires", [])) <= dependency_ids:
                    fail("unknown dependency: " + ident)
            identity = {k: entry[k] for k in ("id", "name", "version", "summary", "homepage")}
            files["nanolathe-mod.json"] = (json.dumps({"schema": 1, **identity}, ensure_ascii=False, indent=2) + "\n").encode()
            filename = ident + "-" + version + ".zip"
            output = args.out / filename
            with zipfile.ZipFile(output, "w", compression=zipfile.ZIP_DEFLATED, compresslevel=9) as archive:
                for path, data in sorted(files.items()):
                    info = zipfile.ZipInfo(path, date_time=(1980, 1, 1, 0, 0, 0))
                    info.create_system = 3
                    info.external_attr = (stat.S_IFREG | 0o644) << 16
                    info.compress_type = zipfile.ZIP_DEFLATED
                    archive.writestr(info, data, compresslevel=9)
            body = output.read_bytes()
            archive = {"url": release_base + filename, "size": len(body), "sha256": hashlib.sha256(body).hexdigest()}
            catalog = dict(identity)
            if kind == "maps":
                catalog.update(map=entry["map"].lower(), requires=entry.get("requires", []))
                for key, fieldtype in PRESENTATION_FIELDS.items():
                    if key not in entry:
                        continue
                    value = entry[key]
                    if isinstance(value, bool) or not isinstance(value, fieldtype):
                        fail("bad presentation field %s on %s" % (key, ident))
                    catalog[key] = value
            catalog["archive"] = archive
            manifest[kind].append(catalog)
            inventory.append({**entry, "archive": archive, "filename": filename,
                              "expanded_size": sum(len(b) for b in files.values()),
                              "files": [{"path": p, "size": len(b), "sha256": hashlib.sha256(b).hexdigest()} for p, b in sorted(files.items())]})
    (args.out / "manifest.json").write_text(json.dumps(manifest, ensure_ascii=False, indent=2) + "\n")
    report = {"schema": 1, "download_bytes": sum(e["archive"]["size"] for e in inventory),
              "expanded_bytes": sum(e["expanded_size"] for e in inventory), "packages": inventory}
    (args.out / "inventory.json").write_text(json.dumps(report, ensure_ascii=False, indent=2) + "\n")
    print(f"{len(manifest['maps'])} maps, {len(manifest['dependencies'])} dependencies; {report['download_bytes']} download bytes, {report['expanded_bytes']} expanded bytes")


if __name__ == "__main__":
    main()
