#!/usr/bin/env python3
"""Curate a local map lab from a reviewable recipe.

The recipe names each map (TA Archive entry), its page and zip URL and the
browser's presentation fields. This tool downloads the ZIPs into a cache,
expands the authored .ufo with tools/map-expand, keeps the credits text, runs
tools/package-maps and tools/map-previews, and rewrites the manifest URLs to
relative paths so the lab directory can be served from a local HTTP server for
NANOLATHE_MAP_CATALOG (docs/DESIGN_MODS_MUTATORS.md §5.6).

Nothing is published: the lab is local content and the recipe is the only
reviewable input. Map bytes and generated packages stay outside the repository.

Usage:
  tools/map-curate --recipe tools/map-curate/recipes/ta-archive-prototype.json \
                   --lab ~/nanolathe-map-lab \
                   --base "/path/to/Total Annihilation" [--refresh] [--no-previews]
"""
import argparse
import hashlib
import json
import pathlib
import re
import shutil
import subprocess
import sys
import time
import urllib.request
import zipfile

REPO = pathlib.Path(__file__).resolve().parents[1]
USER_AGENT = "nanolathe-map-lab/0.1 (+https://nanolathe.gg)"


def fail(message):
    raise SystemExit("map-curate: " + message)


def run(cmd, **kwargs):
    print("+", " ".join(str(part) for part in cmd))
    return subprocess.run([str(part) for part in cmd], check=True, **kwargs)


def download(url, target, refresh):
    if target.exists() and not refresh and zipfile.is_zipfile(target):
        return hashlib.sha256(target.read_bytes()).hexdigest()
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(request, timeout=120) as response:
        data = response.read()
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_bytes(data)
    if not zipfile.is_zipfile(target):
        target.unlink()
        fail(f"{url} did not answer a ZIP archive")
    return hashlib.sha256(data).hexdigest()


def credits_text(zip_path):
    """Concatenate the archive's root-level text documents, the authored
    credits the package keeps (DESIGN_MODS_MUTATORS §5.5/§5.6)."""
    chunks = []
    with zipfile.ZipFile(zip_path) as archive:
        for name in sorted(archive.namelist()):
            if "/" in name.rstrip("/") or not name.lower().endswith((".txt", ".md")):
                continue
            body = archive.read(name).decode("utf-8", "replace").strip()
            if body:
                chunks.append("== " + name + " ==\n" + body)
    return "\n\n".join(chunks)


def slug(title):
    text = re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-")
    return re.sub(r"-{2,}", "-", text)[:64].strip("-") or "map"


# cut_section removes one [name]{...} block, matching braces. It mirrors
# tools/map-features-prune's rule so both steps agree on what a section is.
def cut_section(text, name):
    header = re.compile(r"(?i)\[\s*" + re.escape(name) + r"\s*\]")
    match = header.search(text)
    if not match:
        return text, False
    brace = text.find("{", match.end())
    if brace < 0:
        return text, False
    depth = 0
    for i in range(brace, len(text)):
        if text[i] == "{":
            depth += 1
        elif text[i] == "}":
            depth -= 1
            if depth == 0:
                end = i + 1
                while end < len(text) and text[end] in "\r\n":
                    end += 1
                return text[: match.start()] + text[end:], True
    return text, False


def section_bodies(root):
    """name -> {body: [paths]} for every feature section under root."""
    found = {}
    for tdf in sorted(root.rglob("*.tdf")):
        text = tdf.read_text(errors="replace")
        for match in re.finditer(r"(?i)\[\s*([^\]]+?)\s*\]", text):
            name = match.group(1).strip().lower()
            brace = text.find("{", match.end())
            if brace < 0:
                continue
            depth = 0
            for i in range(brace, len(text)):
                if text[i] == "{":
                    depth += 1
                elif text[i] == "}":
                    depth -= 1
                    if depth == 0:
                        body = text[brace : i + 1]
                        found.setdefault(name, {}).setdefault(body, []).append(tdf)
                        break
    return found


def promote_shared_features(dep_root, map_roots):
    """Feature names several map roots define differently move into the
    dependency: one copy is kept there, every map's copy is dropped. The
    mount-time audit refuses differing same-name definitions across installed
    packages (docs/DESIGN_MODS_MUTATORS.md §5.6), so the maps would otherwise
    exclude each other. Returns (promoted, touched roots): the caller must
    make every touched map require the dependency."""
    owners = {}
    for root in map_roots:
        for name, bodies in section_bodies(root).items():
            owners.setdefault(name, {})
            for body, paths in bodies.items():
                owners[name].setdefault(body, []).append(root)
    dep_defined = set(section_bodies(dep_root)) if dep_root.is_dir() else set()
    promoted, touched = [], set()
    for name in sorted(owners):
        bodies = owners[name]
        if len(bodies) < 2:
            continue  # one shape everywhere: no conflict
        if name in dep_defined:
            canonical = None
        else:
            # Deterministic choice: the body owned by the alphabetically first
            # root, so a rerun keeps the same bytes.
            canonical = sorted(bodies.items(), key=lambda item: sorted(r.name for r in item[1]))[0][0]
            promoted_root = dep_root / "features" / "promoted"
            promoted_root.mkdir(parents=True, exist_ok=True)
            (promoted_root / (slug(name) + ".tdf")).write_text("[" + name + "]\n" + canonical + "\n")
            promoted.append((name, len(bodies)))
        for root in map_roots:
            for tdf in sorted(root.rglob("*.tdf")):
                text = tdf.read_text(errors="replace")
                changed = False
                while True:
                    text, ok = cut_section(text, name)
                    if not ok:
                        break
                    changed = True
                if not changed:
                    continue
                touched.add(root)
                if "[" not in text:
                    tdf.unlink()
                else:
                    tdf.write_text(text)
    return promoted, touched


def find_archives(root):
    return [p for p in root.rglob("*") if p.is_file() and p.suffix.lower() in (".ufo", ".hpi", ".ccx", ".gp3", ".swx")]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--recipe", required=True, type=pathlib.Path)
    parser.add_argument("--lab", required=True, type=pathlib.Path)
    parser.add_argument("--base", type=pathlib.Path, default=None,
                        help="retail install root, for map-previews and --verify")
    parser.add_argument("--refresh", action="store_true", help="re-download cached ZIPs")
    parser.add_argument("--no-previews", action="store_true")
    parser.add_argument("--verify", action="store_true", help="run tools/map-verify afterwards")
    parser.add_argument("--prune-base-features", action="store_true",
                        help="drop feature sections a root redefines against the base install")
    parser.add_argument("--promote-shared-features", action="store_true",
                        help="move features several map roots define differently into the dependency")
    args = parser.parse_args()

    recipe = json.loads(args.recipe.read_text())
    if recipe.get("schema") != 1:
        fail("unsupported recipe schema")
    version = recipe.get("version", "r2010")
    lab = args.lab.expanduser().resolve()
    cache, tmp, roots, out = lab / "cache", lab / "tmp", lab / "roots", lab / "out"
    for directory in (cache, tmp, roots, out):
        directory.mkdir(parents=True, exist_ok=True)

    # A clean build keeps the lab diffable against the recipe.
    for directory in (tmp, roots, out):
        for child in directory.iterdir():
            shutil.rmtree(child) if child.is_dir() else child.unlink()

    package_maps, dependencies = [], []
    for dep in recipe.get("dependencies", []):
        entry = {key: value for key, value in dep.items() if key != "root"}
        if "root" in dep:
            # A recipe may name a local root (relative to the lab) to package
            # as a dependency; the built catalogue serves it like any other.
            source = pathlib.Path(dep["root"]).expanduser()
            if not source.is_absolute():
                source = lab / source
            target = roots / dep["id"]
            if not source.is_dir():
                fail(f"dependency root missing: {source}")
            shutil.copytree(source, target)
        dependencies.append(entry)
    inventory = []
    for entry in recipe["maps"]:
        ident = entry["id"]
        if not re.fullmatch(r"[a-z0-9-]{1,64}", ident):
            fail("unsafe id: " + ident)
        archive = cache / (ident + ".zip")
        digest = download(entry["url"], archive, args.refresh)
        time.sleep(0.2)  # be polite to the fan archive hosting the source ZIPs
        staging = tmp / ident
        staging.mkdir(parents=True, exist_ok=True)
        with zipfile.ZipFile(archive) as z:
            z.extractall(staging)
        source = find_archives(staging)
        root = roots / ident
        for authored in source:
            run(["go", "run", "./tools/map-expand", "--archive", authored, "--out", root], cwd=REPO)
        # Some TA Archive repacks carry the authored map loose instead of in an
        # archive; the package root takes both shapes, including loose files at
        # the ZIP root rather than under maps/.
        for directory in ("maps", "features"):
            loose = staging / directory
            if not loose.is_dir():
                continue
            (root / directory).mkdir(parents=True, exist_ok=True)
            for file in sorted(loose.iterdir()):
                if file.is_file() and file.suffix.lower() in (".ota", ".tnt", ".tdf"):
                    shutil.copyfile(file, root / directory / file.name)
        for pattern in ("*.ota", "*.tnt"):
            for file in sorted(staging.rglob(pattern)):
                if file.parent.name.lower() == "maps":
                    continue
                (root / "maps").mkdir(parents=True, exist_ok=True)
                shutil.copyfile(file, root / "maps" / file.name)
        root.mkdir(parents=True, exist_ok=True)
        credits = credits_text(archive)
        if credits:
            (root / "CREDITS.txt").write_text(credits + "\n")
        maps = sorted((root / "maps").glob("*.ota"))
        if not maps:
            fail(f"{ident}: no maps/*.ota in the source")
        produced = []
        if len(maps) == 1:
            produced.append((root, maps[0].name, entry["title"]))
        else:
            # A pack ZIP holds several authored maps; each becomes its own
            # package with the pack's shared support so it stays self-sufficient
            # (docs/DESIGN_MODS_MUTATORS.md §5.6).
            shared = [d for d in ("features", "anims", "objects3d", "textures") if (root / d).is_dir()]
            for picture in maps:
                sub_id = ident + "-" + slug(picture.stem)
                sub = roots / sub_id
                (sub / "maps").mkdir(parents=True, exist_ok=True)
                for suffix in (".ota", ".tnt"):
                    authored = picture.with_suffix(suffix)
                    if authored.exists():
                        shutil.copyfile(authored, sub / "maps" / authored.name)
                for directory in shared:
                    shutil.copytree(root / directory, sub / directory)
                if credits:
                    (sub / "CREDITS.txt").write_text(credits + "\n")
                produced.append((sub, picture.name, f"{entry['title']} \u2014 {picture.stem}"))
            shutil.rmtree(root)
        for produced_root, picture_name, display in produced:
            record = {
                "id": produced_root.name,
                "name": display,
                "version": version,
                "summary": entry.get("desc") or "Community map from the r2010 collection.",
                "homepage": entry.get("page", ""),
                "map": "maps/" + picture_name,
                "requires": entry.get("requires", []),
            }
            for key in ("author", "players", "sizemap", "year", "kind", "ai"):
                if key in entry:
                    record[key] = entry[key]
            package_maps.append(record)
            print(f"{record['id']}: {display}")
        inventory.append({"id": ident, "title": entry["title"], "source": entry["url"],
                          "sha256": digest, "page": entry.get("page", ""),
                          "packages": [r["id"] for r in package_maps[-len(produced):]]})

    build_recipe = {"schema": 1, "release_base": "https://maps.local/",
                    "maps": package_maps, "dependencies": dependencies}
    recipe_path = roots / "recipe.json"
    recipe_path.write_text(json.dumps(build_recipe, indent=2) + "\n")
    if args.promote_shared_features:
        if not dependencies:
            fail("--promote-shared-features needs a recipe dependency to hold the shared features")
        dep_id = dependencies[0]["id"]
        dep_root = roots / dep_id
        promoted, touched = promote_shared_features(dep_root, [roots / record["id"] for record in package_maps])
        for name, shapes in promoted:
            print(f"promoted [{name}] into {dep_id} ({shapes} shapes)")
        for record in package_maps:
            if roots / record["id"] in touched and dep_id not in record.get("requires", []):
                record.setdefault("requires", []).append(dep_id)
        # The build recipe is written before packaging; keep it in step.
        build_recipe["maps"] = package_maps
        recipe_path.write_text(json.dumps(build_recipe, indent=2) + "\n")
    if args.prune_base_features:
        if args.base is None:
            fail("--base is required for --prune-base-features")
        for dep in dependencies:
            run(["go", "run", "./tools/map-features-prune", "--base", args.base,
                 "--root", roots / dep["id"]], cwd=REPO)
        for record in package_maps:
            cmd = ["go", "run", "./tools/map-features-prune", "--base", args.base,
                   "--root", roots / record["id"], "--map", record["map"]]
            for dep_id in record.get("requires", []):
                cmd += ["--dep", roots / dep_id]
            run(cmd, cwd=REPO)
    run([sys.executable, REPO / "tools" / "package-maps", "--root", roots,
         "--recipe", recipe_path, "--out", out], cwd=REPO)

    if not args.no_previews:
        if args.base is None:
            fail("--base is required unless --no-previews")
        run(["go", "run", "./tools/map-previews", "--manifest", out / "manifest.json",
             "--archives", out, "--root", args.base, "--out", out / "previews",
             "--annotate",
             "--features-root", lab / "features/community-features",
             "--url", "https://maps.local/previews/"], cwd=REPO)

    # Relative URLs resolve against the manifest's own origin, so one local
    # HTTP server serves the manifest, the packages and the previews.
    manifest = json.loads((out / "manifest.json").read_text())
    for group in ("maps", "dependencies"):
        for entry in manifest.get(group, []):
            entry["archive"]["url"] = pathlib.PurePosixPath(entry["archive"]["url"]).name
            if "preview" in entry:
                entry["preview"]["url"] = "previews/" + pathlib.PurePosixPath(entry["preview"]["url"]).name
    (out / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
    (out / "lab.json").write_text(json.dumps({"version": version, "inventory": inventory}, indent=2) + "\n")

    if args.verify:
        if args.base is None:
            fail("--base is required for --verify")
        run(["go", "run", "./tools/map-verify", "--manifest", out / "manifest.json",
             "--archives", out, "--base", args.base], cwd=REPO)

    total = sum(e["archive"]["size"] for e in manifest["maps"])
    print(f"map-curate: {len(manifest['maps'])} maps, {total} bytes; serve {out}")


if __name__ == "__main__":
    main()
